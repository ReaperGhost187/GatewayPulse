<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GatewayPulse</AssemblyName>
    <RootNamespace>GatewayPulse.Service</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GatewayPulse.Core\GatewayPulse.Core.csproj" />
    <ProjectReference Include="..\GatewayPulse.PowerMonitoring\GatewayPulse.PowerMonitoring.csproj" />
    <ProjectReference Include="..\GatewayPulse.RfMonitoring\GatewayPulse.RfMonitoring.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Local preview seeds — never ship in the production installer. -->
    <Content Remove="mockup-*.json" />
    <None Remove="mockup-*.json" />
    <None Include="mockup-*.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
